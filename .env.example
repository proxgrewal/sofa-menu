# SOFA environment configuration. Copy to .env.local for local dev and set the
# same keys as encrypted secrets in your host (Vercel) and GitHub Actions.
# The app runs WITHOUT any of these (in-memory seed data); set them to enable
# the production Postgres + storage layer.
#
# This file is a COMMITTED TEMPLATE — keep every value blank. Put real secrets
# only in .env.local (gitignored) or your host's encrypted secret store.

# Public origin of the deployment (used for absolute QR URLs).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (Postgres DB + dish-photos storage bucket).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (migrations / server-side queries).
DATABASE_URL=

# Owner admin authentication (SOFA-16). The /admin panel edits live prices and
# products, so it is gated behind an owner password + signed session cookie.
# The app runs WITHOUT these using insecure dev defaults (password "sofa-admin");
# ALWAYS set both in any shared/production deployment.
ADMIN_PASSWORD=
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=
# Optional: session lifetime in hours (default 12).
ADMIN_SESSION_TTL_H=12

# Per-restaurant owner passwords (multi-tenant). JSON map of slug -> password.
# When set, each owner logs in scoped to their own restaurant only. ADMIN_PASSWORD
# above still works as a superadmin across all restaurants. Leave empty to run
# single-tenant (ADMIN_PASSWORD unlocks every admin).
# Example: {"pilot-diner":"diner-pass","olive-grove":"grove-pass"}
SOFA_OWNERS=

# Payments (Stripe). Optional — with no keys, orders stay "pay at table"
# (paymentStatus "deferred"). Set these to enable online prepayment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
